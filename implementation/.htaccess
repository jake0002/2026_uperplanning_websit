DirectoryIndex index.html index.php

<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
    AddType "text/markdown; charset=UTF-8" .md
    AddCharset UTF-8 .md .txt
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^/?class\.html$ /ux-academy/ [R=301,L,QSA]
    RewriteRule ^/?uxplan\.html$ /ux-research/ [R=301,L,QSA]
</IfModule>

Redirect 301 /class.html /ux-academy/
Redirect 301 /ux-blog/post-1/ /ux-blog/button-copy-clarity-conversion/
Redirect 301 /ux-blog/post-2/ /ux-blog/interview-question-design-mistakes/
Redirect 301 /ux-blog/post-3/ /ux-blog/ux-spec-document-developer-confusion/
Redirect 301 /ux-blog/post-4/ /ux-blog/ai-wireframe-ux-criteria/
Redirect 301 /ux-blog/post-5/ /ux-blog/startup-ux-consulting-reasons/
RedirectMatch gone "^/ux-blog/post-([6-9]|1[0-9])/?(index\.html)?$"

# ---- 196 cache rules (start): versioned (?v=) assets 30 days, unversioned js/css/pdf/docs revalidate, unversioned images/fonts 1 day ----
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|pdf|txt|md|xml|json)$">
        Header set Cache-Control "no-cache"
        Header set Cache-Control "public, max-age=2592000" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|mp4)$">
        Header set Cache-Control "public, max-age=86400"
        Header set Cache-Control "public, max-age=2592000" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
    </FilesMatch>
</IfModule>
# ---- 196 cache rules (end) ----

# ---- 202 legacy cleanup (start): old page URLs -> 301 new pages / backup & work files -> 403 ----
RedirectMatch 301 ^/ux_academy\.html$ /ux-academy/
RedirectMatch 301 ^/ux_design\.html$ /ux-design/
RedirectMatch 301 ^/ux_design_cleanroom\.html$ /ux-design/
RedirectMatch 301 ^/ux_research\.html$ /ux-research/
RedirectMatch 301 ^/ux_writing\.html$ /ux-writing/
RedirectMatch 301 ^/ux_company\.html$ /ux-company/
RedirectMatch 301 ^/ux_blog\.html$ /ux-blog/
RedirectMatch 301 ^/research(/|/index\.html)?$ /ux-research/
RedirectMatch 301 ^/company(/|/index\.html)?$ /ux-company/
RedirectMatch 301 ^/app_dev(/|/index\.html)?$ /web-app-development/
RedirectMatch 301 ^/ux-research/llms\.txt$ /llms.txt
<FilesMatch "(\.bak|\.bak[_-].*|_b64\.txt|^README\.md|\x20.*\.txt)$">
    Require all denied
</FilesMatch>
# ---- 202 legacy cleanup (end) ----

# ---- 203 b-preview cleanup (start): retired B-design preview folder -> 301 same live page (files kept on disk) ----
RedirectMatch 301 ^/b-preview/(.*/)?index\.html$ /$1
RedirectMatch 301 ^/b-preview(?:/(.*))?$ /$1
# ---- 203 b-preview cleanup (end) ----
